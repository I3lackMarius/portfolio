# Local development only. Never replace this with a production connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_dev
PORT=5000
NODE_ENV=development

# Exact browser origins; no wildcard or path.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session lifetime is capped at 24 hours.
SESSION_MAX_AGE_MS=86400000

# Replace locally with a private random value (at least 32 characters).
LOGIN_RATE_LIMIT_SECRET=replace-with-a-random-value-of-at-least-32-characters

# Optional legacy service settings; do not use production values in development.
EMAIL_USER=replace-with-email-user
EMAIL_PASS=replace-with-email-password
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
ADMIN_EMAIL=replace-with-admin-email
